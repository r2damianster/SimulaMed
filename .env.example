# API key para Groq
# Obtén una clave gratuita en: https://console.groq.com/keys
# IMPORTANTE: NO compartir ni commitear con la clave real
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Modelo de Groq (opcional, defecto: llama-3.3-70b-versatile)
# Ver disponibles: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
